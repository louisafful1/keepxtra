# EmailJS credentials — https://dashboard.emailjs.com
# These are inlined into the build at build time, so they must be set in the
# environment that runs `npm run build` (e.g. your host's build settings).
#
# Account -> Public Key
VITE_EMAILJS_PUBLIC_KEY=your_public_key
# Email Services -> your service ID
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
# Email Templates -> the template wired to the contact form
VITE_EMAILJS_CONTACT_TEMPLATE_ID=template_xxxxxxx
# Email Templates -> the template wired to the newsletter sign-up
VITE_EMAILJS_NEWSLETTER_TEMPLATE_ID=template_xxxxxxx
