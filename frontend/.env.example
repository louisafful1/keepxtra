# EmailJS credentials — https://dashboard.emailjs.com
# These are inlined into the build at build time, so they must be set in the
# environment that runs `npm run build` (e.g. your host's build settings).
#
# The live values live outside the repo on purpose: an EmailJS public key works
# from any origin, so committing one invites spam through the account. Set them in
# the host's environment settings and restrict the key to the keepxtra.com domain
# in the EmailJS dashboard.
#
# Which inbox receives a submission is decided by the EmailJS template, not here:
#   contact form -> info@keepxtra.com
#   newsletter   -> info@keepxtra.com
#
# Account -> Public Key
VITE_EMAILJS_PUBLIC_KEY=your_public_key
# Email Services -> your service ID
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
# Email Templates -> the template wired to the contact form
# Template variables sent: from_name, reply_to, phone, subject, message
VITE_EMAILJS_CONTACT_TEMPLATE_ID=template_xxxxxxx
# Email Templates -> the template wired to the newsletter sign-up
# Template variables sent: from_name, reply_to, email
VITE_EMAILJS_NEWSLETTER_TEMPLATE_ID=template_xxxxxxx
