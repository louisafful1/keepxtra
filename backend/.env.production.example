# Production environment. See .env.example for what every variable does;
# this file only calls out production-specific defaults and requirements.
#
# env.ts actively rejects this file if deployed as-is: every secret below is
# a placeholder, CORS_ORIGIN points nowhere real, and the JWT secrets are
# identical strings — all three would fail startup validation on purpose.

NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

CORS_ORIGIN=https://app.keepxtra.example.com
FRONTEND_URL=https://app.keepxtra.example.com

MONGODB_URI=mongodb+srv://<user>:<password>@<production-cluster>.mongodb.net/keepxtra?retryWrites=true&w=majority
# Raise with real traffic/instance count — see docs/deployment for guidance.
MONGODB_MAX_POOL_SIZE=20

REDIS_URL=redis://<production-redis-host>:6379

# Generate with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Store these in your platform's secret manager, never in a committed file.
JWT_ACCESS_SECRET=replace-with-a-real-production-secret-generated-per-deployment
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-real-production-secret
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace-with-a-real-production-cookie-secret

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20

LOG_LEVEL=info
