# Staging environment — mirrors production as closely as possible so issues
# surface here first, not in front of real users. See .env.example for what
# every variable does; this file only calls out staging-specific defaults.

NODE_ENV=staging
PORT=4000
API_PREFIX=/api/v1

# Real staging frontend origin — NOT localhost (env.ts rejects localhost here).
CORS_ORIGIN=https://staging.keepxtra.example.com
FRONTEND_URL=https://staging.keepxtra.example.com

# A separate staging cluster/database — never point staging at the production database.
MONGODB_URI=mongodb+srv://<user>:<password>@<staging-cluster>.mongodb.net/keepxtra_staging?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=10

REDIS_URL=redis://<staging-redis-host>:6379

# Generate real, unique secrets — never reuse production's. E.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-real-staging-only-secret-do-not-reuse-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-real-staging-only-secret
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace-with-a-real-staging-only-cookie-secret

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Slightly more verbose than production to make pre-release debugging easier.
LOG_LEVEL=debug
