# ==================================================
# Application
# ==================================================
# development | test | staging | production
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Used to build password-reset / email-verification links
FRONTEND_URL=http://localhost:5173

# ==================================================
# Database
# ==================================================
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/keepxtra?retryWrites=true&w=majority
# Only used when NODE_ENV=test; overrides MONGODB_URI in that case.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/keepxtra_test
# Mongoose connection pool ceiling. Raise for production concurrency, leave low for local dev.
MONGODB_MAX_POOL_SIZE=10

# ==================================================
# Cache / rate-limit store (optional)
# ==================================================
# Leave unset to run without Redis — caching and rate limiting both fall back
# to safe in-memory/no-op behavior automatically.
REDIS_URL=redis://localhost:6379

# ==================================================
# Auth
# ==================================================
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-string
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace-with-a-random-32-char-hex-string

# Failed-login lockout: how many bad attempts before a temporary lock, and how long it lasts.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ==================================================
# Rate limiting
# ==================================================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
# Tighter ceiling applied only to /auth/* endpoints (login, register, refresh, password reset).
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# ==================================================
# Logging
# ==================================================
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
