# Test environment. In practice the test suite (tests/setup.ts) sets every
# one of these programmatically before the app loads, spins up a disposable
# in-memory MongoDB, and never reads a real .env.test file — this exists so
# the shape of a "test" environment is documented, and for the rare case of
# running the compiled app directly against NODE_ENV=test.

NODE_ENV=test
PORT=4000
API_PREFIX=/api/v1

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/keepxtra_test_placeholder
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/keepxtra_test

JWT_ACCESS_SECRET=test-access-secret-0123456789-0123456789
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-refresh-secret-0123456789-0123456789
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=test-cookie-secret-0123456789-0123

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Keep test output quiet — flip to "debug" when diagnosing a failing test.
LOG_LEVEL=silent
